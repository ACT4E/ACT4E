\begin{Verbatim}[commandchars=\\\{\},codes={\catcode`\$=3\catcode`\^=7\catcode`\_=8}]
\PYG{c+c1}{\PYGZsh{} for the first example, we expect this object to exist}
\PYG{n}{obx} \PYG{o}{=} \PYG{n}{GenericObject}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}X\PYGZdq{}}\PYG{p}{,} \PYG{l+m+mi}{1}\PYG{p}{)}
\PYG{n}{objects} \PYG{o}{=} \PYG{n}{sc}\PYG{o}{.}\PYG{n}{objects}\PYG{p}{()}
\PYG{k}{assert} \PYG{n}{objects}\PYG{o}{.}\PYG{n}{contains}\PYG{p}{(}\PYG{n}{obx}\PYG{p}{)}
\PYG{c+c1}{\PYGZsh{} ask for the homset of X}
\PYG{n}{homset} \PYG{o}{=} \PYG{n}{sc}\PYG{o}{.}\PYG{n}{hom}\PYG{p}{(}\PYG{n}{obx}\PYG{p}{,} \PYG{n}{obx}\PYG{p}{)}

