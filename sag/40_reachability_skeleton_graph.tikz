\begin{tikzpicture}
    \node at (0,0){
        \begin{tikzcd}[
                graphcd,
                every arrow/.append style={-Triangle},
                column sep=small, row sep=small,
                execute at end picture={
                        \node[draw=gray, dashed, rounded corners, inner sep=1pt, fit=(A)(B)] {};
                        \node[draw=gray, dashed, rounded corners, inner sep=1pt, fit=(C)(D)(E)] {};
                    }
            ]
            |[alias=A]| a \arrow[r, shift left=0.1cm] & |[alias=B]| b \arrow[l, shift left=0.1cm] \arrow[r] & |[alias=C]| c \arrow[dr] & \\
                                                     &                                                   & |[alias=E]| e \arrow[u] & |[alias=D]| d \arrow[l]
        \end{tikzcd}
    };
\end{tikzpicture}
