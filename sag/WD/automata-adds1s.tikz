\begin{tikzpicture}[shorten >=1pt,node distance=2cm,on grid,auto] 
   \node[state] (q_0)   {$0$}; 
   \node[state] (q_1) [ right=of q_0] {$1$}; 
    \path[->] 
    (q_0) edge [bend left] node{$1$}  (q_1)
        edge  [loop above] node {$0$} (q0)
    (q_1) edge [bend left] node{$1$} (q_0)
        edge  [loop above] node {$0$} (q1);
\end{tikzpicture}