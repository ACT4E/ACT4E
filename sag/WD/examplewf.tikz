\begin{tikzpicture}[oriented WD, bbx = .5cm, bby =0.25cm, bb port length=4pt, bb port sep=.75, bb min width=1cm, bb min height=1cm]
    \node[bb={0}{0}{2}{2}, minimum height = 1cm] (A){};
    
    \node[bb={0}{0}{3}{3}, fit={($(A.north west)+(0,1.5)$)($(A.south east)+(0, -1.5)$)}] (tot){};
    
    \draw[ar, color=violet] (tot_top1') to [out=-90, in=90] (A_top1);

     \draw[ar, color=violet] (tot_top2') to [out=-90, in=90] (A_top2);

    \draw[ar, color=violet] (tot_top1') to [out=-90, in=90] (A_top1);  

    \draw[color=blue, dashed] (A_top1') to [out=-90, in=90] (A_bot1);

  \draw[color=blue, dashed] (A_top2') to [out=-90, in=90] (A_bot2);

  \draw[ar, color=violet] (A_bot1) to [out=-90, in=90] (tot_bot1);

    \draw[ar, color=violet] (A_bot2) to [out=-90, in=90] (tot_bot3);



         \draw[ar, color=violet] let \p1=(A.south east), \p2=(A.north east), \n1=\bbportlen, \n2=\bby in
     (A_bot1') to [out=-90, in=-90] (\x1 + \bby, \y1 - \n1) to [out=90, in=-90] (\x2 + \bby, \y2 +\n1) to [out=90, in=90] (A_top2);
  

    
    
\end{tikzpicture}