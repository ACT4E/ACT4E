\begin{tikzpicture}[every text node part/.style={align=center}, oriented WD, bbx =1cm, bby =.5cm, bb min width=1.5cm, bb min height=1.5cm,bb port length=4pt, bb port sep=1]
	\node[bb={0}{0}{0}{1}, minimum height=1.5cm] (X) {$\dot r = \beta r$};
	\node[bb={0}{0}{1}{0},  minimum height=1.5cm, right = 1cm of X] (Y) {$\dot f = \alpha e f$};
	\node[bb={0}{0}{0}{0}, fit={($(X.north west)+(.5,.5)$) ($(Y.south east)+(-.5,-.5)$)}] (tot) {};
	
	\node[right = 1ex of tot](eq) {$=$};
	\node[bb={0}{0}{0}{0},  minimum height=1.5cm, right= 1ex of eq] (Z) {$\dot r = \beta r$\\ $\dot f = \alpha rf$};
	\draw[label] 
		node [right = 2pt of Y_top1] {$e$}
		node [left = 2pt of X_bot1, yshift = -1ex] {$r$}
		;
		
     \draw[ar, color =violet] let \p1=(X.south east), \p2=(Y.north west), \n1=\bbportlen, \n2=\bby in
  		(X_bot1') to [out=-90, in=-90](\x1/2+\x2/2,\y1-\n1) -- (\x1/2+\x2/2,\y2+\n1) to [out=90,in=90](Y_top1);
\end{tikzpicture}