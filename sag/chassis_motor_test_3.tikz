\begin{tikzpicture}[DP]
    \node[dp={2}{1}] (dc) {\begin{tabular}{c}
            chassis + motor \\ \includegraphics[width=\dpiconwidth]{chassis}
            \includegraphics[width=\dpiconwidth]{dc_motor}
        \end{tabular}};

    \node[dp={1}{2}, right=1.25cm of dc] (bat) {\begin{tabular}{c}
            battery \\ \includegraphics[width=\dpiconwidth]{battery}
        \end{tabular}};

    \node[dp={2}{1}, left=1.3cm of dc_fun2, minimum height=0.75cm] (sum) {+};


    \node[dp={1}{1}, left=2.25cm of dc_fun1] (id) {$\idname$};




    % connection between chassis+motor and battery
    \draw[rconn, rcname={}, fcname={}, posres=0.5, posfun=0.5, relfun=above, relres=above] (dc_res1) -- (bat_fun1){};


    % Left of Chassis+Motor
    \draw[funconn, funame={}] (id_fun1){};
    \draw[funconn, runame={}] (sum_fun1){};
    \draw[rconn, rcname={}, fcname={}, posres=0.5, posfun=0.5, relfun=above, relres=above] (sum_res1) -- (dc_fun2){};
    \draw[rconn, rcname={}, fcname={}, posres=0.5, posfun=0.5, relfun=above, relres=above] (id_res1) -- (dc_fun1){};



    % Loop from Plus
    \node[draw=none,circle,inner sep=0pt,color=black,fill=white,opacity=1.0,line width=0mm, below=1cm of sum_fun2 ] (test1) {};


    

    % Loop from Battery
    \node[draw=none,circle,inner sep=0pt,color=black,fill=white,opacity=1.0,line width=0mm, below=1cm of bat_res2] (test2) {};

    %\draw[\dpred, dashed] (bat_res2) to[in=0,out=0,looseness=2] (test2) {};


    % Connections Right from Battery
    \draw[runconn, runame={}] (bat_res1){};

    % Feedback loop
   
    %\draw[\dpgreen] (test1.east) to[in=0,out=180,looseness=0] (node.west) {};
