    \node[draw,circle,inner sep=0pt,color=black,fill=white,opacity=1.0,line width=0.2mm, right=3cm of leftbotnode] (node) {$\succeq$};

    \node[draw=none,circle,inner sep=0pt,color=black,fill=white,opacity=1.0,line width=0mm, left=1cm of sum_fun2] (leftnode) {};

    \draw[\dpgreen] (leftnode) to[in=0,out=180,looseness=0] (sum_fun2.west) {};

    \node[draw=none,circle,inner sep=0pt,color=black,fill=white,opacity=1.0,line width=0mm, right=1cm of bat_res2] (rightnode) {};

    \node[draw=none,circle,inner sep=0pt,color=black,fill=white,opacity=1.0,line width=0mm, below=1.85cm of leftnode] (leftbotnode) {};
    \node[draw=none,circle,inner sep=0pt,color=black,fill=white,opacity=1.0,line width=0mm, below=2cm of rightnode] (rightbotnode) {};

    \draw[\dpred, dashed] (bat_res2) to[in=0,out=-180,looseness=0] node[pos=0.5, below]{} (rightnode); %VERTICAL LEFT

    \draw[\dpgreen] (leftnode) to[in=-90,out=90,looseness=0] node[pos=0.5, below]{} (leftbotnode);
    \draw[\dpred, dashed] (rightnode) to[in=-90,out=90,looseness=0] node[pos=0.5, below]{} (rightbotnode); %VERTICAL right

    \draw[\dpgreen] (leftbotnode) to[in=0,out=180,looseness=0] node[pos=0.5, below]{\F{\unit[mass]{[g]}}} (node.west);
    \draw[\dpred, dashed] (node.east) to[in=0,out=180,looseness=0] node[pos=0.5, below]{} (rightbotnode);






